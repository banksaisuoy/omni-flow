# Copy to .env.local for development or configure these in the deployment platform.
# Never commit .env, .env.local, or real provider credentials.

NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require
NEXTAUTH_SECRET=replace-with-a-random-64-character-secret
NEXTAUTH_URL=https://your-production-domain.example

# Required only when using Gemini-backed AI features.
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase client configuration, if the corresponding feature is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Optional server integrations.
ENCRYPTION_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_SECRET=replace-with-a-random-64-character-secret
REFRESH_SECRET=replace-with-a-random-64-character-secret
RENDER_API_KEY=
